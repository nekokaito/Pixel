{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "headers": [
    {
      "source": "/assets/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=31536000,immutable"
        }
      ]
    },
    {
      "source": "/*.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=2592000"
        }
      ]
    },
    {
      "source": "/*.mp3",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=2592000"
        }
      ]
    },
    {
      "source": "/*.wav",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public,max-age=2592000"
        }
      ]
    }
  ]
}
